<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.fordring</groupId>
    <artifactId>fordring-backend</artifactId>
    <version>0.1.0</version>
    <name>Fordring Backend</name>
    <description>Tirion Fordring Arthas management platform backend</description>

    <properties>
        <java.version>21</java.version>
        <start-class>com.fordring.FordringApplication</start-class>
        <arthas.package.version>4.2.0</arthas.package.version>
        <arthas.package.sha256>2489d42868d2d71dac3893fc6c4b01cae380597eb0cd33ea36f4b243cfd9e011</arthas.package.sha256>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.hierynomus</groupId>
            <artifactId>sshj</artifactId>
            <version>0.39.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.220</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/main/resources</directory>
            </testResource>
            <testResource>
                <directory>src/standalone/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-arthas-http-client-tool</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/arthas-http-client-classes"/>
                                <mkdir dir="${project.build.outputDirectory}/tools"/>
                                <javac
                                        srcdir="${project.basedir}/arthas-http-client/src/main/java"
                                        destdir="${project.build.directory}/arthas-http-client-classes"
                                        includeantruntime="false"
                                        release="11"/>
                                <jar
                                        destfile="${project.build.outputDirectory}/tools/fordring-arthas-http-client.jar"
                                        basedir="${project.build.directory}/arthas-http-client-classes">
                                    <manifest>
                                        <attribute name="Main-Class" value="com.fordring.tools.ArthasHttpClient"/>
                                    </manifest>
                                </jar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>standalone</id>
            <properties>
                <start-class>com.fordring.standalone.FordringStandaloneApplication</start-class>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <version>2.2.220</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <finalName>fordring-standalone-${project.version}</finalName>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                    </resource>
                    <resource>
                        <directory>src/standalone/resources</directory>
                    </resource>
                </resources>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>build-standalone-frontend</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>npm</executable>
                                    <workingDirectory>${project.basedir}/../frontend</workingDirectory>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build:standalone</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-standalone-frontend</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/../frontend/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>download-fixed-arthas-package</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target unless="arthas.package.local.path">
                                        <mkdir dir="${project.build.outputDirectory}/tools"/>
                                        <get
                                                src="https://maven.aliyun.com/repository/public/com/taobao/arthas/arthas-packaging/${arthas.package.version}/arthas-packaging-${arthas.package.version}-bin.zip"
                                                dest="${project.build.outputDirectory}/tools/arthas-bin.zip"
                                                retries="3"
                                                verbose="true"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>copy-local-fixed-arthas-package</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target if="arthas.package.local.path">
                                        <mkdir dir="${project.build.outputDirectory}/tools"/>
                                        <copy
                                                file="${arthas.package.local.path}"
                                                tofile="${project.build.outputDirectory}/tools/arthas-bin.zip"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-fixed-arthas-package</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <checksum
                                                file="${project.build.outputDirectory}/tools/arthas-bin.zip"
                                                algorithm="SHA-256"
                                                property="arthas.package.sha256.actual"/>
                                        <condition property="arthas.package.sha256.matches">
                                            <equals arg1="${arthas.package.sha256.actual}" arg2="${arthas.package.sha256}"/>
                                        </condition>
                                        <fail unless="arthas.package.sha256.matches"
                                              message="arthas-bin.zip SHA-256 mismatch: expected ${arthas.package.sha256}, actual ${arthas.package.sha256.actual}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
